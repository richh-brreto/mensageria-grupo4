RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

RABBITMQ_EXCHANGE=mensageria.aula.exchange
RABBITMQ_QUEUE=mensageria.aula.queue
RABBITMQ_ROUTING_KEY=mensageria.aula.routing
RABBITMQ_DLX=mensageria.aula.dlx
RABBITMQ_DLQ=mensageria.aula.dlq
RABBITMQ_DLQ_ROUTING_KEY=mensageria.aula.dlq.routing

# Provedor de WhatsApp: "twilio" (padrao) ou "evolution".
WHATSAPP_PROVEDOR=twilio

# --- Twilio (usado quando WHATSAPP_PROVEDOR=twilio) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_auth_token
WHATSAPP_REMETENTE=+14155238886

# Content Template aprovado pelo Twilio. Com o content-sid informado a mensagem
# e enviada exatamente como no curl (sem body/texto livre).
WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: variaveis do template no formato JSON. Ex.: {"1":"22 July 2026","2":"3:15pm"}
# WHATSAPP_CONTENT_VARIABLES=

# --- Evolution API (usada quando WHATSAPP_PROVEDOR=evolution) ---
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCIA=minha-instancia
EVOLUTION_API_KEY=sua-api-key
